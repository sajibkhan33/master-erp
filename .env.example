# MongoDB Database URI (Local or MongoDB Atlas Cloud)
# Examples:
# Local: mongodb://127.0.0.1:27017/master-erp
# Cloud Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/master-erp?retryWrites=true&w=majority
MONGODB_URI="mongodb://127.0.0.1:27017/master-erp"

# Google Gemini API Key for AI Chef & Recipe Advisor (Get free from https://aistudio.google.com/)
GEMINI_API_KEY=""

# Application Port and URL
PORT=3000
APP_URL="http://localhost:3000"
